<Window x:Class="CoolWatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoolWatch" Width="260" SizeToContent="Height" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True"
        MouseLeftButtonDown="Drag">
    <Border CornerRadius="12" Background="#E61E1E24" Padding="14" BorderBrush="#444" BorderThickness="1">
        <StackPanel TextElement.Foreground="White">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Click="Close_Click" Background="Transparent" Foreground="White" BorderThickness="0" Padding="6,0" ToolTip="Zamknij"/>
                <TextBlock Text="CoolWatch" FontWeight="Bold" FontSize="14"/>
            </DockPanel>
            <TextBlock x:Name="CpuTemp" Text="--°C" FontSize="40" FontWeight="Bold" Margin="0,6,0,0"/>
            <TextBlock Text="Temperatura procesora" Foreground="#AAA" FontSize="11"/>
            <TextBlock x:Name="Details" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="Limit procesora (mniej = chłodniej):" Margin="0,12,0,2" FontSize="11" Foreground="#CCC"/>
            <DockPanel>
                <TextBlock x:Name="LimitText" DockPanel.Dock="Right" Text="100%" Width="40" TextAlignment="Right"/>
                <Slider x:Name="LimitSlider" Minimum="50" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        ValueChanged="Limit_Changed" Thumb.DragCompleted="Limit_Released"/>
            </DockPanel>
            <ToggleButton x:Name="MaxBox" Content="❄ MAX chłodzenie" Margin="0,12,0,0" Padding="0,6" FontWeight="Bold"
                          Checked="Max_Changed" Unchecked="Max_Changed"
                          ToolTip="Aktywna polityka chłodzenia Windows + wentylatory na 100% (jeśli laptop pozwala)"/>
            <CheckBox x:Name="AutoBox" Content="Auto-chłodzenie (limit 70% po 85°C)" Foreground="White" Margin="0,8,0,0" FontSize="11"/>

            <StackPanel x:Name="FanPanel" Margin="0,10,0,0"/>
            <TextBlock x:Name="Info" Foreground="#E0A040" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
